{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:execution-plan:v1",
  "title": "Plano de Execução",
  "description": "Plano produzido pelo copy-chief: workflow escolhido, passos ordenados por agente e task, contratos de saída, gates humanos e próxima ação. O plano nunca executa nada por si.",
  "type": "object",
  "required": [
    "meta",
    "demand_id",
    "objective",
    "demand_type",
    "risk_level",
    "workflow_id",
    "steps",
    "next_action"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "demand_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "demand_type": {
      "enum": [
        "conversion",
        "content",
        "crm",
        "product_ux",
        "video",
        "brand",
        "research"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "workflow_id": {
      "enum": [
        "wf-copy-production",
        "wf-campaign-launch",
        "wf-fast-variation",
        "wf-performance-loop",
        "wf-content-repurposing"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "agent": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "task": {
            "type": "string",
            "pattern": "^tasks/[a-z-]+\\.md$"
          },
          "input_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_contract": {
            "type": "string"
          },
          "human_approval": {
            "type": "boolean"
          },
          "gate": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "SAMPLING",
              null
            ]
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "step",
          "agent",
          "task",
          "output_contract",
          "human_approval"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_effort": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
