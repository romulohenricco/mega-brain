{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:video-script:v1",
  "title": "Video Script",
  "description": "Contrato de saída do video-social-scriptwriter: roteiro de vídeo ou conteúdo social (reel, YouTube, anúncio, story, VSL ou webinar) com marcação de tempo, locução, texto em tela e direção visual.",
  "type": "object",
  "required": [
    "meta",
    "brief_id",
    "format",
    "platform",
    "duration_seconds",
    "hook",
    "script",
    "cta"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "brief_id": {
      "type": "string"
    },
    "format": {
      "enum": [
        "reel",
        "youtube",
        "ad",
        "story",
        "vsl",
        "webinar"
      ]
    },
    "platform": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "hook": {
      "type": "string"
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "voiceover"
        ],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string"
          },
          "voiceover": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "visual_direction": {
            "type": "string"
          }
        }
      }
    },
    "cta": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
