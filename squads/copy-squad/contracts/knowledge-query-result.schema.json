{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:knowledge-query-result:v1",
  "title": "Knowledge Query Result (resultado de consulta à biblioteca)",
  "description": "Resposta do knowledge-curator a uma consulta à base de conhecimento e à biblioteca de ativos do negócio, com relevância e lacunas explícitas.",
  "type": "object",
  "required": [
    "meta",
    "query",
    "results",
    "missing_knowledge"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "query": {
      "type": "string"
    },
    "filters": {
      "type": "object",
      "additionalProperties": true,
      "description": "Filtros aplicados (livre)"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "title",
          "type",
          "asset_status",
          "summary",
          "source_path",
          "relevance"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "proof",
              "angle",
              "email",
              "landing",
              "script",
              "insight",
              "learning",
              "voice",
              "ux",
              "content"
            ]
          },
          "asset_status": {
            "enum": [
              "approved",
              "draft",
              "rejected",
              "testing"
            ]
          },
          "summary": {
            "type": "string"
          },
          "source_path": {
            "type": "string",
            "pattern": "^\\.data/copy-squad/"
          },
          "performance": {
            "type": "object",
            "additionalProperties": true
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "missing_knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
