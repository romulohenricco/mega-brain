{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:publish-receipt:v1",
  "title": "Publish Receipt (recibo de entrega)",
  "description": "Comprovante de que um ativo aprovado foi entregue (ou agendado, ou entregue a humano). Registra o resultado do approval_tools.py verify --for-execution feito depois da decisão e imediatamente antes da execução, a contra-assinatura do copy-chief e o plano de reversão. Nenhum subagent executa ação externa: executed_by é o humano ou a sessão principal, depois da contra-assinatura; o copy-publisher só emite o pacote de execução e registra o recibo.",
  "type": "object",
  "required": [
    "meta",
    "asset_id",
    "approval_decision_id",
    "payload_sha256",
    "destination",
    "channel",
    "executed_by",
    "executed_at",
    "verification",
    "rollback_plan",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "asset_id": {
      "type": "string"
    },
    "approval_decision_id": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "destination": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "executed_by": {
      "enum": [
        "human",
        "main_session"
      ],
      "description": "Quem executou a ação externa: o humano ou a sessão principal (após a contra-assinatura do copy-chief). Subagents nunca executam."
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_reference": {
      "type": "string",
      "description": "ID/URL externo da publicação, quando houver"
    },
    "verification": {
      "type": "object",
      "required": [
        "sha_match",
        "approval_valid",
        "not_expired",
        "bound_match",
        "verify_ok",
        "counter_signed_by",
        "counter_signed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "sha_match": {
          "type": "boolean",
          "description": "Hash recalculado do conteúdo a executar == request.payload_sha256 == decision.payload_sha256."
        },
        "approval_valid": {
          "type": "boolean",
          "description": "decision == approved, human_attested e recorded_via válidos."
        },
        "not_expired": {
          "type": "boolean",
          "description": "now < decision.expires_at."
        },
        "bound_match": {
          "type": "boolean",
          "description": "decision.bound_to == gate/operation/destination/channel do pedido e do que será executado."
        },
        "verify_ok": {
          "type": "boolean",
          "description": "Saída ok do approval_tools.py verify --for-execution, reexecutado sem flags pelo copy-chief."
        },
        "counter_signed_by": {
          "const": "copy-chief",
          "description": "Executor do QG-PUBLISH-PREFLIGHT (D7/D8)."
        },
        "counter_signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rollback_plan": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "published",
        "scheduled",
        "handed_off",
        "failed"
      ]
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
