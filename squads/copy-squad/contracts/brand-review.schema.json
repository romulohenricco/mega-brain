{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:brand-review:v1",
  "title": "Brand Review",
  "description": "Contrato de saída do brand-voice-guardian ao revisar uma peça: aderência ao guia de voz, problemas por severidade com trecho e sugestão, e decisão de avanço para a próxima etapa.",
  "type": "object",
  "required": [
    "meta",
    "text_id",
    "brand_guide_id",
    "brand_alignment_score",
    "tone_match",
    "issues",
    "approved_for_next_stage"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "text_id": {
      "type": "string",
      "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$",
      "description": "meta.artifact_id da versão exata do draft revisado, no formato {asset_id}-v{n} (D14)."
    },
    "brand_guide_id": {
      "type": "string"
    },
    "brand_alignment_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "tone_match": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "excerpt",
          "problem"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "medium",
              "low"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "suggested_revision": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "approved_for_next_stage": {
      "type": "boolean"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
