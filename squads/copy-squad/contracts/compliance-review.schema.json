{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:compliance-review:v1",
  "title": "Compliance Review",
  "description": "Contrato de saída do compliance-checker: risco geral, claims classificados por tipo e status de verificação, alertas legais, de plataforma e LGPD, separação epistêmica (fatos, recomendações, hipóteses) e decisão de aprovação.",
  "type": "object",
  "required": [
    "meta",
    "copy_id",
    "overall_risk",
    "claims",
    "epistemic",
    "approved",
    "requires_legal_review"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "copy_id": {
      "type": "string",
      "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$",
      "description": "meta.artifact_id da versão exata do draft revisado, no formato {asset_id}-v{n} (D14)."
    },
    "overall_risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "claim_type",
          "status",
          "required_action"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string"
          },
          "claim_type": {
            "enum": [
              "price",
              "guarantee",
              "result",
              "authority",
              "testimonial",
              "comparison",
              "health",
              "financial",
              "data_privacy",
              "other"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "unverified",
              "false",
              "risky"
            ]
          },
          "source": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "legal_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag",
          "reference",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "flag": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "platform_policy_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "policy",
          "issue"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          }
        }
      }
    },
    "lgpd_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approved": {
      "type": "boolean"
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_legal_review": {
      "type": "boolean"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
