{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:localization:v1",
  "title": "Localization",
  "description": "Contrato de saída do localization-specialist: transcriação de uma peça para outro idioma ou região, com adaptações culturais justificadas, termos intraduzíveis e indicação de nova checagem de compliance.",
  "type": "object",
  "required": [
    "meta",
    "source_copy_id",
    "source_locale",
    "target_locale",
    "localized_sections",
    "requires_compliance_recheck"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "source_copy_id": {
      "type": "string",
      "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*-v[0-9]+$",
      "description": "meta.artifact_id da versão exata do draft revisado, no formato {asset_id}-v{n} (D14)."
    },
    "source_locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,4})?(-[A-Z]{2})?$"
    },
    "target_locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,4})?(-[A-Z]{2})?$"
    },
    "localized_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "adaptation_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original",
          "adapted",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "original": {
            "type": "string"
          },
          "adapted": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "cultural_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untranslatable_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_compliance_recheck": {
      "type": "boolean"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
