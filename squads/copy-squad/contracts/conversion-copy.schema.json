{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:conversion-copy:v1",
  "title": "Conversion Copy",
  "description": "Contrato de saída do conversion-copywriter: copy de conversão (landing page, página de vendas, anúncio, e-mail ou sequência) estruturada em seções, com claims e provas declarados para revisão posterior.",
  "type": "object",
  "required": [
    "meta",
    "brief_id",
    "angle_id",
    "format",
    "sections",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "brief_id": {
      "type": "string"
    },
    "angle_id": {
      "type": "string"
    },
    "format": {
      "enum": [
        "landing_page",
        "sales_page",
        "ad",
        "email",
        "sequence"
      ],
      "description": "Formato de conversão. VSL é do video-social-scriptwriter (video-script, format vsl), não do conversion-copywriter."
    },
    "awareness_stage": {
      "enum": [
        "unaware",
        "problem_aware",
        "solution_aware",
        "product_aware",
        "most_aware"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section",
          "copy"
        ],
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string"
          },
          "copy": {
            "type": "string"
          },
          "cta": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_approval": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "variation_id",
          "element",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "variation_id": {
            "type": "string"
          },
          "element": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
