{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:angles:v1",
  "title": "Ângulos e Hooks",
  "description": "Lista ranqueada de ângulos e hooks com promessa, prova necessária, risco e força prevista. A regra de no mínimo 20 ângulos é do quality gate QG-ANGLES, não do schema.",
  "type": "object",
  "required": [
    "meta",
    "brief_id",
    "angles"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "research_id": {
      "type": "string"
    },
    "angles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "angle_id": {
            "type": "string",
            "pattern": "^ang-[a-z0-9-]+$"
          },
          "angle": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "promise": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string"
          },
          "proof_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "awareness_stage": {
            "enum": [
              "unaware",
              "problem_aware",
              "solution_aware",
              "product_aware",
              "most_aware"
            ]
          },
          "risk_level": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "predicted_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "needs_approval": {
            "type": "boolean"
          }
        },
        "required": [
          "angle_id",
          "angle",
          "hook",
          "promise",
          "risk_level",
          "predicted_strength",
          "reason",
          "needs_approval"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
