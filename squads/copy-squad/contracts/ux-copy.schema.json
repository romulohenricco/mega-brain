{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:copy-squad:contract:ux-copy:v1",
  "title": "UX Copy",
  "description": "Contrato de saída do ux-writer: microcopy de interface por superfície (onboarding, formulário, erro, estado vazio, dashboard, modal ou notificação), com limites de caracteres e notas de acessibilidade.",
  "type": "object",
  "required": [
    "meta",
    "surface",
    "context",
    "copy"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "surface": {
      "enum": [
        "onboarding",
        "form",
        "error",
        "empty_state",
        "dashboard",
        "modal",
        "notification"
      ]
    },
    "context": {
      "type": "string"
    },
    "copy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "element",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "element": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "character_limit": {
            "type": "integer"
          },
          "accessibility_note": {
            "type": "string"
          }
        }
      }
    },
    "glossary_terms_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_id",
        "artifact_type",
        "business",
        "produced_by",
        "produced_at",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "artifact_type": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^camp-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "business": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "produced_by": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "ready",
            "needs_input",
            "needs_approval",
            "approved",
            "rejected",
            "blocked",
            "published",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "locator",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "locator": {
          "type": "string",
          "description": "URL pública ou caminho repo-relativo/.data"
        },
        "type": {
          "enum": [
            "primary",
            "official",
            "customer",
            "internal",
            "secondary"
          ]
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
